# Dockerfile.notify - Notification Streaming Service
FROM python:3.10-slim

# Set a working directory
WORKDIR /app

# Install dependencies (Flask for the web service mock)
RUN pip install --no-cache-dir Flask

# Copy the scaffold script
COPY notification_service.py /app/

# Port for the notification service
EXPOSE 5000

# Run the web service
CMD ["flask", "--app", "notification_service", "run", "--host=0.0.0.0"]
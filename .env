# =============================================================================
# Financial Fraud Detection Pipeline - Environment Configuration
# Single source of truth for all paths and settings
#
# USAGE: Copy this file to .env
#   cp env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# FlashBlade Storage Paths (High-Throughput)
# -----------------------------------------------------------------------------
# Base FlashBlade mount point
FB_MOUNT=/mnt/fsaai-shared/ebiser

# Pod 1 Output: Generated transaction data
FB_DATA=${FB_MOUNT}/fraud-data

# Pod 2 Output: Prepared features
FB_PREP=${FB_MOUNT}/prep-output

# -----------------------------------------------------------------------------
# Model Repository (Pod 3 Output → Pod 4 Input)
# -----------------------------------------------------------------------------
# Use absolute path - relative paths cause container issues
# This is where Triton expects to find models
FA_MODEL_REPO=${PWD}/model_repository

# -----------------------------------------------------------------------------
# Pod 1: Data Generation Settings
# -----------------------------------------------------------------------------
NUM_WORKERS=128
DURATION_SECONDS=60
CHUNK_SIZE=1000000
FRAUD_RATE=0.005

# -----------------------------------------------------------------------------
# Pod 2: Feature Engineering Settings
# -----------------------------------------------------------------------------
MAX_FILES_PER_RUN=100
USE_MULTI_GPU=true
LATEST_ONLY=true

# -----------------------------------------------------------------------------
# Pod 6: Inference Benchmark Settings
# -----------------------------------------------------------------------------
# Duration of sustained throughput test per model (CPU and GPU)
BENCHMARK_DURATION=60

# Batch size for inference (records per batch)
BENCHMARK_BATCH_SIZE=10000

# Number of concurrent workers for GPU inference (uses gRPC)
# More workers = better GPU utilization under concurrent load
BENCHMARK_WORKERS=8

# -----------------------------------------------------------------------------
# S3 Configuration (TODO - FlashBlade S3 Endpoint)
# -----------------------------------------------------------------------------
#S3_ENDPOINT=https://flashblade.example.com
#S3_ACCESS_KEY=your_s3_access_key
#S3_SECRET_KEY=your_s3_secret_key
#S3_BUCKET=fraud-detection-bucket

# -----------------------------------------------------------------------------
# TODO: Override specific input files
# -----------------------------------------------------------------------------
#INPUT_FILE=
#FEATURES_FILE=
